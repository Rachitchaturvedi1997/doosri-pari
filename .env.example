# Doosri Pari — environment. Copy to .env and fill in. NEVER commit the real file.
#
# Only SECRET_KEY, POSTGRES_PASSWORD and PUBLIC_BASE_URL are needed to boot. Every
# provider below is optional; without it the matching feature reports "not
# configured" instead of failing. In production the API refuses readiness (and
# logs an error at startup) if the SAFETY-CRITICAL ones - a push channel, an SMS
# provider, an IVR provider - are missing, because a missed check-in that reaches
# nobody is the failure this app exists to prevent.

# --- core -------------------------------------------------------------------
ENV=production
SECRET_KEY=change-me-to-64-random-hex-characters
POSTGRES_PASSWORD=change-me
PUBLIC_BASE_URL=https://api.doosripari.in
LOG_LEVEL=INFO
SUPPORT_EMAIL=support@doosripari.in
GRIEVANCE_OFFICER=Grievance Officer, Doosri Pari, <address>
RUN_MIGRATIONS_ON_START=false
TRUST_PROXY=true

# --- push (SAFETY-CRITICAL) --------------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=/run/secrets/fcm-service-account.json
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=/run/secrets/AuthKey.p8
APNS_TOPIC=in.doosripari.app
APNS_SANDBOX=false
APNS_CRITICAL_ALERTS=false        # true only after Apple grants the entitlement

# --- SMS: DLT-registered templates (SAFETY-CRITICAL) --------------------------
SMS_PROVIDER=msg91                # msg91 | fast2sms | twilio
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DPARI
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_GENERIC=
MSG91_TEMPLATE_GUARDIAN_ALERT=
MSG91_TEMPLATE_SOS=
MSG91_TEMPLATE_ALL_CLEAR=
MSG91_TEMPLATE_INVITE=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- WhatsApp Business Cloud API ---------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_ALERT=doosri_alert
WHATSAPP_TEMPLATE_ALL_CLEAR=doosri_all_clear

# --- IVR check-in call (SAFETY-CRITICAL) --------------------------------------
IVR_PROVIDER=twilio               # twilio | exotel
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_FLOW_URL=

# --- language models & embeddings --------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_STRONG=claude-sonnet-5-5
VOYAGE_API_KEY=                   # voyage-3 is 1024-dimensional, matching the column
VOYAGE_MODEL=voyage-3
EMBEDDINGS_URL=                   # or any OpenAI-compatible /embeddings endpoint (1024-dim)
EMBEDDINGS_KEY=
EMBEDDINGS_MODEL=bge-m3

# --- speech to text -----------------------------------------------------------
STT_PROVIDER=                     # whisper | google
STT_URL=https://api.openai.com/v1/audio/transcriptions
STT_KEY=
STT_MODEL=whisper-1
GOOGLE_SPEECH_API_KEY=

# --- object storage -----------------------------------------------------------
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=                      # MinIO / R2 / localstack; empty for AWS
# credentials come from the instance role, not from here

# --- payments -----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=         # payouts to mentors
GOOGLE_PLAY_PACKAGE=in.doosripari.app
GOOGLE_PLAY_SERVICE_ACCOUNT=/run/secrets/play-service-account.json
GOOGLE_PUBSUB_VERIFY_TOKEN=
APPSTORE_KEY_ID=
APPSTORE_ISSUER_ID=
APPSTORE_KEY=/run/secrets/SubscriptionKey.p8
APPSTORE_BUNDLE_ID=in.doosripari.app
APPSTORE_ROOT_CERT=/run/secrets/AppleRootCA-G3.pem
APPSTORE_SANDBOX=false

# --- sign-in ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_SERVICE_ID=

# --- voice rooms --------------------------------------------------------------
LIVEKIT_URL=wss://rooms.doosripari.in
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- data feeds ---------------------------------------------------------------
PANCHANG_URL=                     # a licensed panchang vendor, or drop festivals-<year>.json into PANCHANG_DIR
PANCHANG_KEY=
